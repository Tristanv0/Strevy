{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "strevy-api",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "api.tristancheng.com",
			"custom_domain": true
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://tristancheng.com,https://www.tristancheng.com",
		"HEVY_TIMEZONE": "America/Toronto"
	},
	"browser": { "binding": "HEVY_BROWSER" },
	"workflows": [
		{
			"binding": "HEVY_REFRESH",
			"name": "strevy-hevy-refresh",
			"class_name": "HevyRefreshWorkflow",
			"concurrency": { "limit": 1 }
		}
	],
	"triggers": { "crons": ["59 3,4 * * *"] },
	"r2_buckets": [
		{
			"binding": "STREVY_DATA",
			"bucket_name": "strevy-data"
		},
		{
			"bucket_name": "strevy-data",
			"binding": "strevy_data"
		}
	]
}
