{
  "name": "strevy-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API for Strava runs and Hevy workouts",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "upload:r2": "node scripts/upload-r2.mjs",
    "scrape:strava": "node scrapers/strava/scrape-strava.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.2"
  }
}
